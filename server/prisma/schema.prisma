generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model TechStack {
  id              String                      @id @default(uuid())
  name            String
  version         String?
  category        String?
  isActive        Boolean                     @default(true)
  createdAt       DateTime                    @default(now())
  updatedAt       DateTime                    @updatedAt
  vulnerabilities TechStackVulnerability[]
}

model Vulnerability {
  id                String                      @id @default(uuid())
  cveId             String?
  title             String
  description       String
  url               String
  source            String
  sourceId          String?
  cvssScore         Float?
  severity          String?
  exploitability    String?
  affectedVersions  String?
  patchedVersion    String?
  aiSummary         String?
  aiImpact          String?
  aiRemediation     String?
  publishedAt       DateTime?
  createdAt         DateTime                    @default(now())
  techStacks        TechStackVulnerability[]

  @@unique([url, source])
}

model TechStackVulnerability {
  id              String        @id @default(uuid())
  techStackId     String
  vulnerabilityId String
  isAffected      Boolean       @default(true)
  matchConfidence Float?
  techStack       TechStack     @relation(fields: [techStackId], references: [id], onDelete: Cascade)
  vulnerability   Vulnerability @relation(fields: [vulnerabilityId], references: [id], onDelete: Cascade)

  @@unique([techStackId, vulnerabilityId])
}

model Notification {
  id              String   @id @default(uuid())
  type            String
  title           String
  content         String
  isRead          Boolean  @default(false)
  vulnerabilityId String?
  createdAt       DateTime @default(now())
}

model Setting {
  id    String @id @default(uuid())
  key   String @unique
  value String
}
